# Core
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/medscribe
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me

# Object storage (MinIO locally, S3 in production)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=medscribe-audio
S3_ACCESS_KEY=...
S3_SECRET_KEY=...
KMS_KEY_ID=...

# ASR
ASR_PRIMARY=sarvam
ASR_FALLBACK=whisper
SARVAM_API_KEY=...

# LLM gateway (keys only for providers you enable)
LLM_TIER_FAST=...
LLM_TIER_STRONG=...
LLM_TIER_JUDGE=...          # must be a different vendor than the drafter
ANTHROPIC_API_KEY=...
GEMINI_API_KEY=...
OPENAI_API_KEY=...
LLM_TENANT_BUDGET_INR=...

# Observability
LANGFUSE_HOST=...
LANGFUSE_PUBLIC_KEY=...
LANGFUSE_SECRET_KEY=...
SENTRY_DSN=...

# Governance
AUDIO_RETENTION_HOURS=24
AUDIT_LOG_RETENTION_DAYS=365
